# Copy to `.env` and fill in.

# Postgres connection string. Required — there is no local file fallback.
# Free database at https://neon.com — use the POOLED connection string
# (the one with `-pooler` in the host), which is what serverless needs.
# Locally you can point this at your own Postgres instead.
DATABASE_URL=

# Signs session cookies. Generate one with: openssl rand -base64 32
# In production the server refuses to start without it — a random per-boot
# secret would sign every user out on each deploy.
SESSION_SECRET=

# Absolute base URL. The Google redirect URI is built from this, so it must
# match what you registered in the Google console exactly.
APP_URL=http://localhost:3000

PORT=3000

# Set to "false" to remove the "Try it without an account" button.
DEMO_MODE=

# Google sign-in — the only way into a real account. Both halves must be set.
# https://console.cloud.google.com → Credentials → OAuth client ID (Web).
# Authorised redirect URI must be exactly: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push, for reminders. Generate with: npm run keys:vapid
# Never regenerate on a live deploy — existing subscriptions are signed against
# the old public key and would silently stop being delivered.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# Guards /api/cron/*, which the platform's scheduler calls. Any random string.
# Without it those endpoints refuse to run at all.
CRON_SECRET=
