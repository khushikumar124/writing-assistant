# Copy to `.env` and fill in. Everything here has a working default in
# development; only SESSION_SECRET is mandatory in production.

# Signs session cookies. Generate one with: openssl rand -base64 32
# In production the server refuses to start without it — a random per-boot
# secret would sign every user out on each deploy.
SESSION_SECRET=

# Where the SQLite file lives, relative to the project root.
DATABASE_URL=./data/app.db

# Absolute base URL. The Google redirect URI is built from this, so it must
# match what you registered in the Google console exactly.
APP_URL=http://localhost:3000

PORT=3000

# Set to "false" to remove the "Try it without an account" button and refuse
# to mint sandbox accounts.
DEMO_MODE=

# Google sign-in — the only way into a real account. Both halves must be set.
# Create at https://console.cloud.google.com → Credentials → OAuth client ID.
# The authorised redirect URI must be exactly: <APP_URL>/api/auth/google/callback
# Without these, only the sandbox button works.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Web Push, for the reminders people opt into. Generate a pair with:
#   npm run keys:vapid
# Never regenerate these on a live deploy — every existing subscription is
# signed against the old public key and would silently stop being delivered.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
