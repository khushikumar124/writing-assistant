# Copy to `.env` and fill in. Everything here has a working default in
# development; only SESSION_SECRET is mandatory in production.

# Signs session cookies. Generate one with: openssl rand -base64 32
# In production the server refuses to start without it — a random per-boot
# secret would sign every user out on each deploy.
SESSION_SECRET=

# Where the SQLite file lives, relative to the project root.
DATABASE_URL=./data/app.db

# Absolute base URL, used to build links inside emails.
APP_URL=http://localhost:3000

PORT=3000

# Set to "false" to remove the "Try it without an account" button and refuse
# to mint sandbox accounts. Leave unset to keep it on.
DEMO_MODE=

# Google sign-in. Both halves must be set or the button stays hidden.
# Create at https://console.cloud.google.com → Credentials → OAuth client ID.
# The authorised redirect URI must be exactly: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outbound email (password resets). Without a key, mail is printed to the
# server console instead of being sent — fine for development, not for users
# who have actually forgotten their password.
RESEND_API_KEY=
MAIL_FROM="Writing Assistant <onboarding@resend.dev>"
